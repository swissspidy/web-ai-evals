{
  "name": "@web-ai-evals/page-runtime",
  "version": "0.1.0",
  "description": "In-page runtime for web-ai-evals: adapters for Chrome and Edge built-in AI, WebLLM and Transformers.js",
  "keywords": [
    "llm",
    "evals",
    "web-ai",
    "browser",
    "built-in-ai",
    "prompt-api",
    "webgpu",
    "webllm",
    "transformers.js",
    "gemini-nano"
  ],
  "homepage": "https://github.com/swissspidy/web-ai-evals/tree/main/packages/page-runtime#readme",
  "bugs": {
    "url": "https://github.com/swissspidy/web-ai-evals/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swissspidy/web-ai-evals.git",
    "directory": "packages/page-runtime"
  },
  "license": "Apache-2.0",
  "author": "Pascal Birchler",
  "type": "module",
  "main": "./index.node.js",
  "types": "./index.node.d.ts",
  "exports": {
    ".": {
      "types": "./index.node.d.ts",
      "default": "./index.node.js"
    }
  },
  "files": [
    "dist",
    "index.node.js",
    "index.node.d.ts"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@mlc-ai/web-llm": "^0.2.85",
    "@web-ai-evals/core": "workspace:*",
    "@webgpu/types": "^0.1.74"
  }
}
