{
  "name": "@web-ai-evals/runner",
  "version": "0.1.0",
  "description": "Run and compare LLM evals inside real browsers: CLI and Node orchestrator for web-ai-evals",
  "keywords": [
    "llm",
    "evals",
    "web-ai",
    "browser",
    "built-in-ai",
    "prompt-api",
    "webgpu",
    "playwright",
    "cli",
    "benchmark"
  ],
  "homepage": "https://github.com/swissspidy/web-ai-evals/tree/main/packages/runner#readme",
  "bugs": {
    "url": "https://github.com/swissspidy/web-ai-evals/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swissspidy/web-ai-evals.git",
    "directory": "packages/runner"
  },
  "license": "Apache-2.0",
  "author": "Pascal Birchler",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@web-ai-evals/core": "workspace:*",
    "@web-ai-evals/page-runtime": "workspace:*",
    "@web-ai-evals/report": "workspace:*",
    "@web-ai-evals/scorers": "workspace:*",
    "playwright": "^1.63.0"
  },
  "bin": {
    "web-ai-evals": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
